{
  "name": "crez-content-factory",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v && pnpm infra:up",
    "db:migrate": "ts-node -T -r tsconfig-paths/register libs/database/src/cli/migrate.ts",
    "db:seed": "ts-node -T -r tsconfig-paths/register libs/database/src/cli/seed.ts",
    "db:reset": "pnpm infra:reset && node -e \"setTimeout(()=>{},6000)\" && pnpm db:migrate && pnpm db:seed",
    "dev:api": "nodemon --quiet --watch apps/api --watch libs -e ts --exec \"ts-node -T -r tsconfig-paths/register apps/api/src/main.ts\"",
    "dev:orchestrator": "nodemon --quiet --watch apps/orchestrator --watch libs -e ts --exec \"ts-node -T -r tsconfig-paths/register apps/orchestrator/src/main.ts\"",
    "dev:worker": "nodemon --quiet --watch apps/worker --watch libs -e ts --exec \"ts-node -T -r tsconfig-paths/register apps/worker/src/main.ts\"",
    "dev:backoffice": "pnpm --filter @cf/backoffice dev",
    "dev": "concurrently -n api,orch,worker,ui -c cyan,magenta,yellow,green \"pnpm dev:api\" \"pnpm dev:orchestrator\" \"pnpm dev:worker\" \"pnpm dev:backoffice\"",
    "start:api": "ts-node -T -r tsconfig-paths/register apps/api/src/main.ts",
    "start:orchestrator": "ts-node -T -r tsconfig-paths/register apps/orchestrator/src/main.ts",
    "start:worker": "ts-node -T -r tsconfig-paths/register apps/worker/src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:e2e": "ts-node -T -r tsconfig-paths/register test/e2e/order-to-publish.e2e.ts",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test:e2e:failure": "ts-node -T -r tsconfig-paths/register test/e2e/failure-scenarios.e2e.ts",
    "test:load": "ts-node -T -r tsconfig-paths/register test/load/concurrent-orders.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
