# ECS Task Definition 환경변수 예시 (prod)
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=api            # api | orchestrator | worker

DATABASE_URL=<from Secrets Manager>
DATABASE_POOL_MAX=20
REDIS_URL=redis://<elasticache-endpoint>:6379
QUEUE_PREFIX=cf

STORAGE_DRIVER=s3
S3_BUCKET=crez-content-factory
S3_REGION=ap-northeast-2
CDN_BASE_URL=https://cdn.crez.example

JWT_ACCESS_SECRET=<from Secrets Manager: crez/jwt/access>
JWT_REFRESH_SECRET=<from Secrets Manager: crez/jwt/refresh>
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600

ADAPTERS=http
ADAPTER_IMAGE_A_URL=
ADAPTER_IMAGE_A_KEY=<from Secrets Manager: crez/adapters/image-a>
ADAPTER_IMAGE_B_URL=
ADAPTER_IMAGE_B_KEY=<from Secrets Manager: crez/adapters/image-b>
ADAPTER_VIDEO_A_URL=
ADAPTER_VIDEO_A_KEY=<from Secrets Manager: crez/adapters/video-a>
ADAPTER_EMBED_URL=
ADAPTER_EMBED_KEY=<from Secrets Manager: crez/adapters/embedding>

QC_PASS_SCORE=80
IDENTITY_THRESHOLD=0.82
IDENTITY_MARGIN=0.04
MAX_GENERATION_RETRY=3
SLA_SCAN_INTERVAL_MS=60000
