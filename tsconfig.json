{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@cf/common": ["libs/common/src/index.ts"],
      "@cf/common/*": ["libs/common/src/*"],
      "@cf/domain": ["libs/domain/src/index.ts"],
      "@cf/domain/*": ["libs/domain/src/*"],
      "@cf/database": ["libs/database/src/index.ts"],
      "@cf/database/*": ["libs/database/src/*"],
      "@cf/orchestration": ["libs/orchestration/src/index.ts"],
      "@cf/orchestration/*": ["libs/orchestration/src/*"],
      "@cf/queue": ["libs/queue/src/index.ts"],
      "@cf/queue/*": ["libs/queue/src/*"],
      "@cf/model-abstraction": ["libs/model-abstraction/src/index.ts"],
      "@cf/model-abstraction/*": ["libs/model-abstraction/src/*"],
      "@cf/storage": ["libs/storage/src/index.ts"],
      "@cf/storage/*": ["libs/storage/src/*"],
      "@cf/contracts": ["libs/contracts/src/index.ts"],
      "@cf/contracts/*": ["libs/contracts/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/backoffice"]
}
