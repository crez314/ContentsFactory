# ─────────────────────────────── 공통 (부록 A)
NODE_ENV=local
LOG_LEVEL=info

# ─────────────────────────────── 데이터베이스
DATABASE_URL=postgres://crez:crez@localhost:55434/crez
DATABASE_POOL_MAX=20

# ─────────────────────────────── Redis / Queue
REDIS_URL=redis://localhost:56379
QUEUE_PREFIX=cf

# ─────────────────────────────── 스토리지
# local 환경에서는 S3 대신 파일시스템 드라이버를 사용한다.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_BUCKET=crez-content-factory
S3_REGION=ap-northeast-2
CDN_BASE_URL=http://localhost:4000/v1/files

# ─────────────────────────────── 인증
# local 환경에서는 Secrets Manager 대신 평문 시크릿을 사용한다 (prod 금지).
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_ACCESS_SECRET_REF=secretsmanager://crez/jwt/access
JWT_REFRESH_SECRET_REF=secretsmanager://crez/jwt/refresh
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ─────────────────────────────── 외부 어댑터
# local: mock 어댑터 사용. dev/stage/prod: http 어댑터 + Secrets Manager 경로.
ADAPTERS=mock
ADAPTER_IMAGE_A_REF=secretsmanager://crez/adapters/image-a
ADAPTER_IMAGE_B_REF=secretsmanager://crez/adapters/image-b
ADAPTER_VIDEO_A_REF=secretsmanager://crez/adapters/video-a
ADAPTER_EMBED_REF=secretsmanager://crez/adapters/embedding

# 로컬 mock 어댑터 동작 제어 (버그 재현·장애 시나리오 테스트용)
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0
MOCK_IDENTITY_BASE=0.90

# ─────────────────────────────── 운영 파라미터
QC_PASS_SCORE=80
IDENTITY_THRESHOLD=0.82
IDENTITY_MARGIN=0.04
MAX_GENERATION_RETRY=3
SLA_SCAN_INTERVAL_MS=60000
MIN_CANDIDATE_ASSETS=8

# ─────────────────────────────── 포트
API_PORT=4000
ORCHESTRATOR_PORT=4001
WORKER_PORT=4002
BACKOFFICE_PORT=3000
